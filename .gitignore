# =============================================================================
# .gitignore - files Git should never track
# =============================================================================
# Rule of thumb: commit what's needed to REBUILD everything (code, config,
# uv.lock, the production model); ignore what can be regenerated, is large,
# is private, or is specific to one machine.
# =============================================================================

# Local Python environment (rebuilt with `uv sync`)
.venv/
__pycache__/
*.pyc

# Data: large, and downloaded by the pipeline when needed (includes data/quick/)
data/

# Quick-run models: disposable test models that must never be committed or
# deployed (the production model lives in models/, which IS committed)
models_quick/

# Experiment tracking and run outputs (regenerated by running the pipeline)
mlruns/
mlartifacts/
mlflow.db
logs/
reports/

# Tool caches and reports
.pytest_cache/
.ruff_cache/
# (Note: .gitignore only allows comments on their own lines, never after a pattern.)
# coverage's raw measurement data, regenerated by every run
.coverage
.coverage.*
coverage.json
# the browsable coverage report (uv run pytest --cov --cov-report=html)
htmlcov/

# Operating system clutter
.DS_Store
Thumbs.db

# NOTE: models/ IS committed on purpose - the API's Docker image is built
# from it, so committing a new model is how it ships to production.
# NOTE: uv.lock IS committed on purpose - it guarantees identical installs.
# NOTE: demo/baseline/ and demo/fallback/ ARE committed on purpose - a fresh
# clone then has the demo's starting model and its safety-net results.
